\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ximeraExam}[2026/01/20 Ximera exam helpers]

% ------------------------------------------------------------
% Exams always define an abstract (required by ximera.cls)
% ------------------------------------------------------------
\providecommand{\theabstract}{}

% ------------------------------------------------------------
% Exam problem environment (already agreed-on)
% ------------------------------------------------------------
\newcounter{examproblem}
\renewcommand{\theexamproblem}{\arabic{examproblem}}

\newenvironment{examproblem}{
  \refstepcounter{examproblem}
  \begin{problem}[2in]
}{
  \end{problem}
}

\newenvironment{examproblems}{
  \setcounter{examproblem}{0}
}{}

% ------------------------------------------------------------
% Internals for addexamproblem
% ------------------------------------------------------------
\makeatletter

% Save original environment definitions
\newcommand{\xmExam@saveEnv}[1]{%
  \expandafter\let\csname xmExam@orig@#1\expandafter\endcsname\csname #1\endcsname
  \expandafter\let\csname xmExam@orig@end@#1\expandafter\endcsname\csname end#1\endcsname
}

\newcommand{\xmExam@restoreEnv}[1]{%
  \expandafter\let\csname #1\expandafter\endcsname\csname xmExam@orig@#1\endcsname
  \expandafter\let\csname end#1\expandafter\endcsname\csname xmExam@orig@end@#1\endcsname
}

% Counter to track nesting of problem-like environments
\newcounter{xmExam@problemDepth}

% Generic wrapper used for exercise/problem/question
\newcommand{\xmExam@wrapProblem}[1]{%
  \stepcounter{xmExam@problemDepth}%
  \ifnum\value{xmExam@problemDepth}=1
    \begin{examproblem}
  \fi
}

\newcommand{\xmExam@endWrapProblem}{%
  \ifnum\value{xmExam@problemDepth}=1
    \end{examproblem}
  \fi
  \addtocounter{xmExam@problemDepth}{-1}%
}

% ------------------------------------------------------------
% Suppress document-level commands during import
% ------------------------------------------------------------
\newcommand{\xmExam@suppressDocumentPreamble}{%
  \let\documentclass\@gobble
  \let\author\@gobble
  \let\outcome\@gobble
  \let\maketitle\relax
}

\newcommand{\xmExam@restoreDocumentPreamble}{%
  % Nothing needed: document-level commands aren’t used again
}

% Neutralize document environment itself
\newenvironment{xmExam@ignoreDocument}{\ignorespaces}{\ignorespaces}

% ------------------------------------------------------------
% addexamproblem environment
% -> allows us to import an existing ximera document to be added
%    as exam problems.
% ------------------------------------------------------------
\makeatletter

\newenvironment{addexamproblem}[1]{%
  % Reset depth tracker for this import
  \setcounter{xmExam@problemDepth}{0}

  % Save original Ximera environments
  \xmExam@saveEnv{exercise}
  \xmExam@saveEnv{question}

  % Suppress document-level constructs
  \xmExam@suppressDocumentPreamble

  % Neutralize document environment itself
  \let\document\xmExam@ignoreDocument
  \let\enddocument\endxmExam@ignoreDocument

  % ------------------------------------------------
  % CRITICAL DESIGN DECISION:
  % Imported exercises/questions become content only.
  % They NEVER emit their own headers.
  % ------------------------------------------------

  \renewenvironment{exercise}
    {%
      \xmExam@wrapProblem{exercise}%
    }
    {%
      \xmExam@endWrapProblem%
    }

  \renewenvironment{question}
    {%
      \xmExam@wrapProblem{question}%
    }
    {%
      \xmExam@endWrapProblem%
    }

  % Import the Ximera document
  \input{#1}

}{%
  % Restore original environments
  \xmExam@restoreEnv{exercise}
  \xmExam@restoreEnv{question}
}

\makeatother